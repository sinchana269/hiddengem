# ──────────────────────────────────────────────
# Neo4j
# Bolt protocol URI – use bolt:// for local, neo4j+s:// for AuraDB cloud
# ──────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
# Default username after a fresh Neo4j install is "neo4j"
NEO4J_USERNAME=neo4j
# The password you set during Neo4j Desktop / server first-run setup
NEO4J_PASSWORD=your_password_here

# ──────────────────────────────────────────────
# Backend
# ──────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ──────────────────────────────────────────────
# Frontend (Next.js – must be prefixed NEXT_PUBLIC_)
# ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
